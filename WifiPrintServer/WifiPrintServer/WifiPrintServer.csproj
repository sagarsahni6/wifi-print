<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>

    <AssemblyName>PrintoraServer</AssemblyName>
    <RootNamespace>WifiPrintServer</RootNamespace>
    <Version>2.0.0</Version>
    <Authors>Printora Team</Authors>
    <Description>Printora Server - Cloud Print &amp; Scan Service</Description>

    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile Condition="'$(SelfContained)' == 'true'">true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- ASP.NET Core (Kestrel web server) -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Docnet.Core" Version="2.6.0" />
    
    <!-- JWT Authentication -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.0" />
    
    <!-- mDNS/Zeroconf discovery -->
    <PackageReference Include="Makaretu.Dns.Multicast" Version="0.27.0" />
    
    <!-- Entity Framework Core + SQLite for persistence -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    
    <!-- JSON serialization (using built-in System.Text.Json) -->
    
    <!-- System tray support (using System.Windows.Forms.NotifyIcon) -->
    
    
    <!-- Logging -->
    <PackageReference Include="Serilog" Version="3.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />

    <!-- Windows printing -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />

    <!-- QR Code generation for connection -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

</Project>
