<Window x:Class="WifiPrintServer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Printora — Cloud Print Server" Height="780" Width="1160"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        MinWidth="980" MinHeight="660"
        FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, sans-serif"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

        <Window.Resources>
        <Style x:Key="SegmentedTabRadio" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBg" Background="Transparent" CornerRadius="4" Padding="8,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBg" Property="Background" Value="White"/>
                                <Setter TargetName="TabBg" Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                <Setter TargetName="TabBg" Property="BorderThickness" Value="1"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <StreamGeometry x:Key="IconCamera">M12 12c1.65 0 3-1.35 3-3s-1.35-3-3-3-3 1.35-3 3 1.35 3 3 3zm0-4c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm8-4h-3.17l-1.83-2H9L7.17 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 14H4V6h4.05l1.83-2h4.24l1.83 2H20v12z</StreamGeometry>
        <StreamGeometry x:Key="IconQrScannerMini">M3 3h8v8H3zm2 2v4h4V5zm8-2h8v8h-8zm2 2v4h4V5zM3 13h8v8H3zm2 2v4h4v-4zm13-2h3v2h-3zm-3 0h2v3h-2zm2 3h3v2h-3zm-2 2h2v3h-2zm3 0h3v3h-3zm0-5h3v2h-3z</StreamGeometry>
        <StreamGeometry x:Key="IconInfoCircle">M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z</StreamGeometry>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════════ Left Navigation Pane (WinUI 3 NavigationView) ══════════════════ -->
        <Border Grid.Column="0" Background="{StaticResource BgSidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Top Brand Tile -->
                <StackPanel DockPanel.Dock="Top" Margin="16,20,16,20">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="38" Height="38" CornerRadius="6" Margin="0,0,12,0"
                                Background="{StaticResource PrimaryLightBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Path Data="{StaticResource IconPrinter}" Fill="{StaticResource PrimaryBrush}"
                                  Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Printora" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Cloud Print Hub" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Pinned Settings NavItem at Bottom (Microsoft standard) -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,12">
                    <!-- Subtle Divider -->
                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="16,4,16,10"/>

                    <RadioButton x:Name="NavSettings"
                                 Style="{StaticResource NavItem}"
                                 Checked="Nav_Checked" Tag="Settings">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconSettings}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/>
                            <TextBlock Text="Settings" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <TextBlock Text="Printora Server v2.0.0" FontSize="10.5"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,10,0,0" Opacity="0.6"/>
                </StackPanel>

                <!-- Server Status Beacon at Bottom -->
                <Border DockPanel.Dock="Bottom" Margin="12,0,12,12"
                        Background="#FFFFFF" CornerRadius="6" Padding="14,12"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="1" BlurRadius="4" Color="#000000" Opacity="0.04" Direction="270"/>
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#107C41" Margin="0,0,7,0"
                                     x:Name="StatusDot"/>
                            <TextBlock x:Name="StatusText" Text="Online"
                                       Foreground="#107C41" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock Text="· mDNS Active" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="6,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="IpText" Text="IP: Loading..."
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2"/>
                        <TextBlock x:Name="PortText" Text="Port: 5000"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2"/>
                        <TextBlock x:Name="CloudStatusText" Text="Cloud: Active"
                                   Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6"
                                   TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                        <Button Style="{StaticResource OutlinedButton}" Click="OpenWebPortal_Click"
                                Padding="8,4" FontSize="11" HorizontalAlignment="Stretch" Cursor="Hand">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="{StaticResource IconGlobe}" Fill="{StaticResource PrimaryBrush}"
                                      Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Open Web Portal" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Navigation Tabs List -->
                <StackPanel Margin="6,0">
                    <RadioButton x:Name="NavDashboard"
                                 Style="{StaticResource NavItem}"
                                 IsChecked="True" Checked="Nav_Checked" Tag="Dashboard">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconDashboard}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/>
                            <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavJobs"
                                 Style="{StaticResource NavItem}"
                                 Checked="Nav_Checked" Tag="Jobs">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconQueue}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/>
                            <TextBlock Text="Print Queue" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavPrinters"
                                 Style="{StaticResource NavItem}"
                                 Checked="Nav_Checked" Tag="Printers">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconPrinter}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/>
                            <TextBlock Text="Printers" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavDevices"
                                 Style="{StaticResource NavItem}"
                                 Checked="Nav_Checked" Tag="Devices">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconDevice}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/>
                            <TextBlock Text="Connected Devices" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavLogs"
                                 Style="{StaticResource NavItem}"
                                 Checked="Nav_Checked" Tag="Logs">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconLogs}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/>
                            <TextBlock Text="Server Logs" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ══════════════════ Main Content Viewport ══════════════════ -->
        <Grid Grid.Column="1" Margin="24,20,24,20">

            <!-- ── 1. Dashboard Page ── -->
            <Grid x:Name="DashboardPage" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Pending Approval Alert -->
                    <RowDefinition Height="Auto"/> <!-- Header & Quick Actions -->
                    <RowDefinition Height="Auto"/> <!-- Drag & Drop Dropzone Banner -->
                    <RowDefinition Height="Auto"/> <!-- 4 Stat Cards -->
                    <RowDefinition Height="*"/>    <!-- Main Split: QR Connect & Recent Jobs -->
                </Grid.RowDefinitions>

                <!-- Pending Device Approval Banner (Windows 11 InfoBar Style) -->
                <Border Grid.Row="0" x:Name="ApprovalBanner" Background="#FFF4CE" BorderBrush="#FCD34D"
                        BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="0,0,0,14"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="4" Background="#FEF3C7"
                                Margin="0,0,12,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconDevice}" Fill="#8F4700" Width="18" Height="18"
                                  Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Connection Request Received" FontSize="13" FontWeight="Bold"
                                       Foreground="#8F4700"/>
                            <TextBlock x:Name="ApprovalDeviceName" Text="" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="#1F1F1F" Margin="0,1,0,0"/>
                            <TextBlock x:Name="ApprovalDeviceIp" Text="" FontSize="11"
                                       Foreground="#5C5C5C"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Click="ApproveDevice_Click"
                                    Background="#107C41" Foreground="White" FontWeight="SemiBold" FontSize="12"
                                    Padding="16,7" Margin="0,0,8,0" BorderThickness="0" Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconCheck}" Fill="White" Width="12" Height="12"
                                          Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Allow Device" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Click="DenyDevice_Click"
                                    Background="#C42B1C" Foreground="White" FontWeight="SemiBold" FontSize="12"
                                    Padding="16,7" BorderThickness="0" Cursor="Hand">
                                <TextBlock Text="Deny" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Dashboard Page Header -->
                <Grid Grid.Row="1" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Dashboard" FontSize="26" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Server overview, phone connection, and document queue"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource OutlinedButton}"
                                Click="CopyUrl_Click" Padding="12,6" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconCopy}" Fill="{StaticResource TextPrimaryBrush}"
                                      Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Copy Address" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource OutlinedButton}"
                                Click="OpenUploadsFolder_Click" Padding="12,6" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconFolder}" Fill="{StaticResource TextPrimaryBrush}"
                                      Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Spool Folder" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource OutlinedButton}"
                                Click="DownloadApp_Click" Padding="12,6">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconDevice}" Fill="{StaticResource TextPrimaryBrush}"
                                      Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Android App" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Quick Print Dropzone Banner -->
                <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#0067C0" BorderThickness="1.5"
                        CornerRadius="6" Padding="16,10" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                                Background="{StaticResource PrimaryLightBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconUpload}" Fill="{StaticResource PrimaryBrush}"
                                  Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Quick Desktop Print — Drag &amp; drop files anywhere"
                                       FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Drop PDF documents, photos, or text files to spool immediately to your default printer."
                                       FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource ModernButton}" Click="BrowsePrintFile_Click"
                                Padding="14,6" VerticalAlignment="Center">
                            <TextBlock Text="Browse Files..." FontSize="12"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- 4 Stat Cards Row -->
                <UniformGrid Grid.Row="3" Columns="4" Margin="0,0,0,16">
                    <!-- Active Jobs -->
                    <Border Style="{StaticResource StatCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Active Jobs" Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12" FontWeight="Normal" Margin="0,0,0,4"/>
                                <TextBlock x:Name="ActiveJobsCount" Text="0" FontSize="26" FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryBrush}"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="36" Height="36" CornerRadius="6"
                                    Background="{StaticResource PrimaryLightBrush}" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconZap}" Fill="{StaticResource PrimaryBrush}"
                                      Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                    <!-- Completed Jobs -->
                    <Border Style="{StaticResource StatCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Completed Jobs" Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12" FontWeight="Normal" Margin="0,0,0,4"/>
                                <TextBlock x:Name="CompletedCount" Text="0" FontSize="26" FontWeight="SemiBold"
                                           Foreground="#107C41"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="36" Height="36" CornerRadius="6"
                                    Background="#DFF6DD" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconCheck}" Fill="#107C41"
                                      Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                    <!-- Printers -->
                    <Border Style="{StaticResource StatCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Printers" Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12" FontWeight="Normal" Margin="0,0,0,4"/>
                                <TextBlock x:Name="PrinterCount" Text="0" FontSize="26" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="36" Height="36" CornerRadius="6"
                                    Background="#F3F3F3" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconPrinter}" Fill="{StaticResource TextPrimaryBrush}"
                                      Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                    <!-- Paired Devices -->
                    <Border Style="{StaticResource StatCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Paired Devices" Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12" FontWeight="Normal" Margin="0,0,0,4"/>
                                <TextBlock x:Name="DeviceCount" Text="0" FontSize="26" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="36" Height="36" CornerRadius="6"
                                    Background="#F3F3F3" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconDevice}" Fill="{StaticResource TextPrimaryBrush}"
                                      Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                </UniformGrid>

                <!-- Main 2-Column Split: Connect (Left) & Recent Jobs (Right) -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="350"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Column 0: Printable Poster Style QR Card (Exact Match to Web Poster) -->
                    <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1.5"
                            CornerRadius="20" Margin="0,0,16,0" Padding="16,18">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.06" Color="#0F172A"/>
                        </Border.Effect>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel HorizontalAlignment="Center">

                                <!-- Mode Switcher: Web Studio vs Android App -->
                                <Border Background="#F1F5F9" CornerRadius="6" Padding="3" Margin="0,0,0,14" HorizontalAlignment="Stretch">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <RadioButton x:Name="QrModeWeb" Grid.Column="0" Content="Web Studio" 
                                                     GroupName="QrMode" IsChecked="True" Checked="QrMode_Checked"
                                                     Style="{StaticResource SegmentedTabRadio}" ToolTip="Scan with any smartphone camera — no app required"/>
                                        <RadioButton x:Name="QrModeApp" Grid.Column="1" Content="Android App" 
                                                     GroupName="QrMode" Checked="QrMode_Checked"
                                                     Style="{StaticResource SegmentedTabRadio}" ToolTip="Pair with Printora Android App"/>
                                    </Grid>
                                </Border>

                                <!-- Top Shop / Machine Logo Row -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,2">
                                    <!-- Blue Squircle Badge with White Printer Icon -->
                                    <Border Width="40" Height="40" CornerRadius="12" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#0067C0" Offset="0.0"/>
                                                <GradientStop Color="#004F96" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.25" Color="#0067C0"/>
                                        </Border.Effect>
                                        <Path Data="{StaticResource IconPrinter}" Fill="White" Width="20" Height="20"
                                              Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="ShopServerName" Text="DESKTOP-PLK2AIK-W" FontSize="15.5" FontWeight="Bold"
                                                   Foreground="#0F172A" />
                                        <TextBlock Text="Self-Service Document Printing" FontSize="11" FontWeight="Medium"
                                                   Foreground="#475569" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Exact Match QR Frame: White box with 2.5px solid #0067C0 border -->
                                <Border Background="#FFFFFF" BorderBrush="#0067C0" BorderThickness="2.5" CornerRadius="18"
                                        Padding="12" Margin="0,14,0,12" HorizontalAlignment="Center">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.12" Color="#0067C0"/>
                                    </Border.Effect>
                                    <Image x:Name="QrCodeImage" Width="175" Height="175"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                </Border>

                                <!-- Scan to Print Header with mini QR icon -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                                    <Path x:Name="QrHeaderIcon" Data="{StaticResource IconQrScannerMini}" Fill="#0067C0" Width="16" Height="16"
                                          Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="QrHeaderTitle" Text="Scan to Print" FontSize="16" FontWeight="Bold"
                                               Foreground="#0067C0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Instruction Subtitle -->
                                <TextBlock x:Name="QrHeaderSubtitle"
                                           Text="Open your phone camera, scan this QR code, and upload any document to print. No app needed!"
                                           FontSize="11" Foreground="#64748B" TextWrapping="Wrap" TextAlignment="Center"
                                           LineHeight="16" Margin="12,0,12,14"/>

                                <!-- 3-Step Process Row: Scan QR -> Upload File -> Collect Print -->
                                <Grid x:Name="StepsRowPanel" HorizontalAlignment="Center" Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="68"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="74"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="68"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Step 1: Scan QR -->
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <Border Width="36" Height="36" CornerRadius="18" Background="#EBF3FB"
                                                BorderBrush="#BCD7F5" BorderThickness="1.5" HorizontalAlignment="Center">
                                            <Path Data="{StaticResource IconCamera}" Fill="#0067C0" Width="16" Height="16"
                                                  Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Scan QR" FontSize="10.5" FontWeight="SemiBold" Foreground="#334155"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <!-- Arrow 1 -->
                                    <TextBlock Grid.Column="1" Text="→" FontSize="16" Foreground="#CBD5E1"
                                               HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"/>

                                    <!-- Step 2: Upload File -->
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                        <Border Width="36" Height="36" CornerRadius="18" Background="#EBF3FB"
                                                BorderBrush="#BCD7F5" BorderThickness="1.5" HorizontalAlignment="Center">
                                            <Path Data="{StaticResource IconUpload}" Fill="#0067C0" Width="15" Height="15"
                                                  Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Upload File" FontSize="10.5" FontWeight="SemiBold" Foreground="#334155"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <!-- Arrow 2 -->
                                    <TextBlock Grid.Column="3" Text="→" FontSize="16" Foreground="#CBD5E1"
                                               HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"/>

                                    <!-- Step 3: Collect Print -->
                                    <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                        <Border Width="36" Height="36" CornerRadius="18" Background="#EBF3FB"
                                                BorderBrush="#BCD7F5" BorderThickness="1.5" HorizontalAlignment="Center">
                                            <Path Data="{StaticResource IconPrinter}" Fill="#0067C0" Width="15" Height="15"
                                                  Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Collect Print" FontSize="10.5" FontWeight="SemiBold" Foreground="#334155"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Supported Format Pills -->
                                <StackPanel x:Name="FormatPillsPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                                    <Border Background="#EBF3FB" BorderBrush="#BCD7F5" BorderThickness="1" CornerRadius="5" Padding="7,2" Margin="0,0,5,0">
                                        <TextBlock Text="PDF" FontSize="10" FontWeight="Bold" Foreground="#0067C0"/>
                                    </Border>
                                    <Border Background="#EBF3FB" BorderBrush="#BCD7F5" BorderThickness="1" CornerRadius="5" Padding="7,2" Margin="0,0,5,0">
                                        <TextBlock Text="DOCX" FontSize="10" FontWeight="Bold" Foreground="#0067C0"/>
                                    </Border>
                                    <Border Background="#EBF3FB" BorderBrush="#BCD7F5" BorderThickness="1" CornerRadius="5" Padding="7,2" Margin="0,0,5,0">
                                        <TextBlock Text="JPG" FontSize="10" FontWeight="Bold" Foreground="#0067C0"/>
                                    </Border>
                                    <Border Background="#EBF3FB" BorderBrush="#BCD7F5" BorderThickness="1" CornerRadius="5" Padding="7,2" Margin="0,0,5,0">
                                        <TextBlock Text="PNG" FontSize="10" FontWeight="Bold" Foreground="#0067C0"/>
                                    </Border>
                                    <Border Background="#EBF3FB" BorderBrush="#BCD7F5" BorderThickness="1" CornerRadius="5" Padding="7,2">
                                        <TextBlock Text="TXT" FontSize="10" FontWeight="Bold" Foreground="#0067C0"/>
                                    </Border>
                                </StackPanel>

                                <!-- Exact URL Display Box with Copy Button -->
                                <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8"
                                        Padding="10,6" Margin="0,0,0,8" HorizontalAlignment="Stretch">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="QrInfoText" Text="" FontSize="11" FontWeight="Medium"
                                                   FontFamily="Consolas, JetBrains Mono, Courier New, monospace"
                                                   Foreground="#475569" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="1" ToolTip="Copy server address"
                                                Width="22" Height="22" Padding="0" Click="CopyUrl_Click"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="4,0,0,0">
                                            <Path Data="{StaticResource IconCopy}" Fill="#475569"
                                                  Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Approval Requirement Note -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                                    <Path Data="{StaticResource IconInfoCircle}" Fill="#94A3B8" Width="12" Height="12"
                                          Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Approval from shop PC required for printing" FontSize="10"
                                               Foreground="#94A3B8" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Powered By Branding -->
                                <TextBlock Text="Powered by Printora Cloud Print Studio" FontSize="9.5" FontWeight="Medium"
                                           Foreground="#CBD5E1" HorizontalAlignment="Center" Margin="0,2,0,12"/>

                                <!-- Shop Owner Control Buttons -->
                                <Grid HorizontalAlignment="Stretch" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Style="{StaticResource ModernButton}" Margin="0,0,3,0"
                                            Click="PrintPoster_Click" Height="34" Padding="6,4"
                                            ToolTip="Open ready-to-print A4 poster in browser for display on counter/desk">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Path Data="{StaticResource IconPrinter}" Fill="White"
                                                  Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Print Poster" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" Style="{StaticResource OutlinedButton}" Margin="3,0,0,0"
                                            Click="OpenWebStudio_Click" Height="34" Padding="6,4"
                                            ToolTip="Preview Web Print Studio in browser">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Path Data="{StaticResource IconGlobe}" Fill="{StaticResource TextPrimaryBrush}"
                                                  Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Open Studio" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Style="{StaticResource OutlinedButton}" Margin="0,0,3,0"
                                            Click="PrintQrCode_Click" Height="28" Padding="4,2"
                                            ToolTip="Send directly to printer">
                                        <TextBlock Text="Direct Print" FontSize="10.5" VerticalAlignment="Center"/>
                                    </Button>
                                    <Button Grid.Column="1" Style="{StaticResource OutlinedButton}" Margin="3,0,0,0"
                                            Click="SaveQrImage_Click" Height="28" Padding="4,2"
                                            ToolTip="Save QR code PNG file">
                                        <TextBlock Text="Save PNG" FontSize="10.5" VerticalAlignment="Center"/>
                                    </Button>
                                </Grid>

                                <!-- Hidden PIN Display & Approval Idle references to satisfy code-behind -->
                                <Border x:Name="ApprovalIdle" Visibility="Collapsed"/>
                                <StackPanel Visibility="Collapsed">
                                    <TextBlock x:Name="PinDisplay" Text="------"/>
                                    <TextBlock x:Name="PinTimerText" Text=""/>
                                    <Button x:Name="RefreshPinButton" Click="RefreshPin_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Column 1: Recent Print Jobs Card (Windows 11 Fluent) -->
                    <Border Grid.Column="1" Style="{StaticResource CardBorder}" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconQueue}" Fill="{StaticResource PrimaryBrush}"
                                          Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Recent Jobs" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Live documents processed by this server" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource OutlinedButton}"
                                        Padding="10,5" FontSize="11" Click="RefreshJobs_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconRefresh}" Fill="{StaticResource TextPrimaryBrush}"
                                              Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- List -->
                            <ListView Grid.Row="1" x:Name="RecentJobsList" Background="Transparent"
                                      BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem" BasedOn="{StaticResource HoverListItem}"/>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F9F9F9" CornerRadius="6"
                                                Padding="12,8" Margin="0,2" BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="4"
                                                        Background="{StaticResource PrimaryLightBrush}" Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource IconQueue}" Fill="{StaticResource PrimaryBrush}"
                                                          Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding OriginalFileName}"
                                                               TextTrimming="CharacterEllipsis" FontSize="12.5" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="10.5"
                                                               Margin="0,1,0,0">
                                                        <Run Text="{Binding PrinterName}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <Border Grid.Column="2" CornerRadius="4" Padding="8,3" Margin="8,0,0,0"
                                                        Background="#DFF6DD" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Status}" FontSize="10.5"
                                                               Foreground="#107C41" FontWeight="SemiBold"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- Empty State -->
                            <Border Grid.Row="1" x:Name="RecentJobsEmptyState" Background="#F9F9F9"
                                    CornerRadius="6" Padding="24" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                    Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center">
                                    <Path Data="{StaticResource IconQueue}" Fill="{StaticResource TextSecondaryBrush}"
                                          Width="36" Height="36" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,10" Opacity="0.35"/>
                                    <TextBlock Text="No recent print jobs" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Documents sent from your Android phone will appear here in real time."
                                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                               HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ── 2. Print Queue Page ── -->
            <Grid x:Name="JobsPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Print Queue" FontSize="26" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Manage active and completed print jobs with real-time status" FontSize="12.5"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Fast Search Box -->
                        <Border Background="#FFFFFF" BorderBrush="{StaticResource BorderStrongBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,10,0" Width="220">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Data="{StaticResource IconSearch}" Fill="{StaticResource TextSecondaryBrush}"
                                      Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" x:Name="SearchJobsInput" TextChanged="SearchJobs_TextChanged"
                                         BorderThickness="0" Background="Transparent" FontSize="12"
                                         VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Button Style="{StaticResource OutlinedButton}"
                                Click="RefreshJobs_Click" Padding="12,6" Margin="0,0,8,0" FontSize="11.5">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconRefresh}" Fill="{StaticResource TextPrimaryBrush}"
                                      Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource OutlinedButton}"
                                Click="ClearCompletedJobs_Click" Padding="12,6" FontSize="11.5">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconTrash}" Fill="{StaticResource TextPrimaryBrush}"
                                      Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Clear Completed" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Quick Action Bar -->
                <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="14,8" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconFolder}" Fill="{StaticResource PrimaryBrush}"
                                  Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Processed files are safely stored in local spool storage."
                                       FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource OutlinedButton}" Click="OpenUploadsFolder_Click"
                                Padding="10,4" FontSize="11">
                            <TextBlock Text="Open Spool Folder"/>
                        </Button>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0">
                    <Grid>
                        <ListView x:Name="JobsList" Background="Transparent"
                                  BorderThickness="0" Padding="8">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="100"/>
                                    <GridViewColumn Header="File" DisplayMemberBinding="{Binding OriginalFileName}" Width="260"/>
                                    <GridViewColumn Header="Printer" DisplayMemberBinding="{Binding PrinterName}" Width="180"/>
                                    <GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="110"/>
                                    <GridViewColumn Header="Progress" DisplayMemberBinding="{Binding Progress}" Width="80"/>
                                    <GridViewColumn Header="Created" DisplayMemberBinding="{Binding CreatedAt}" Width="160"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <Border x:Name="JobsEmptyState" Background="Transparent"
                                Padding="40" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Data="{StaticResource IconQueue}" Fill="{StaticResource TextSecondaryBrush}"
                                      Width="40" Height="40" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,10" Opacity="0.35"/>
                                <TextBlock Text="Print Queue is Empty" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Documents sent from your Android phone will appear here in real time."
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0"
                                           HorizontalAlignment="Center" TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ── 3. Printers Page ── -->
            <Grid x:Name="PrintersPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Installed Printers" FontSize="26" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Printers configured on this Windows computer" FontSize="12.5"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource OutlinedButton}"
                            Click="RefreshPrinters_Click" Padding="12,6" VerticalAlignment="Center" FontSize="11.5">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconRefresh}" Fill="{StaticResource TextPrimaryBrush}"
                                  Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Refresh Printers" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
                <ListView x:Name="PrintersList" Grid.Row="1" Background="Transparent"
                          BorderThickness="0">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource BgCardBrush}" CornerRadius="6"
                                    Padding="16,12" Margin="0,3" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="4"
                                            Background="{StaticResource PrimaryLightBrush}" Margin="0,0,14,0">
                                        <Path Data="{StaticResource IconPrinter}" Fill="{StaticResource PrimaryBrush}"
                                              Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                                   Margin="0,2,0,0">
                                            <Run Text="Driver: "/><Run Text="{Binding DriverName}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border CornerRadius="4" Padding="8,3" Margin="0,0,8,0"
                                                Background="#FFF4CE"
                                                Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="Default Printer" FontSize="10.5" FontWeight="SemiBold"
                                                       Foreground="#A80000"/>
                                        </Border>
                                        <Border CornerRadius="4" Padding="10,4" Background="#DFF6DD">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="6" Height="6" Fill="#107C41" Margin="0,0,5,0"
                                                         VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Status}" FontSize="11"
                                                           Foreground="#107C41" FontWeight="SemiBold"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- ── 4. Devices Page ── -->
            <Grid x:Name="DevicesPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Connected Devices" FontSize="26" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Manage paired mobile devices and access permissions"
                                   FontSize="12.5"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource OutlinedButton}"
                            Click="RefreshDevices_Click" Padding="12,6" VerticalAlignment="Center" FontSize="11.5">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconRefresh}" Fill="{StaticResource TextPrimaryBrush}"
                                  Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Refresh Devices" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
                <Grid Grid.Row="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="DevicesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BgCardBrush}" CornerRadius="6"
                                            Padding="16,12" Margin="0,3" BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- Device Icon -->
                                            <Border Grid.Column="0" Width="38" Height="38" CornerRadius="4"
                                                    Background="{StaticResource PrimaryLightBrush}" Margin="0,0,14,0">
                                                <Path Data="{StaticResource IconDevice}" Fill="{StaticResource PrimaryBrush}"
                                                      Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <!-- Device Info -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                                           Margin="0,2,0,0">
                                                    <Run Text="IP: "/><Run Text="{Binding IpAddress}"/>
                                                    <Run Text="  •  Paired: "/><Run Text="{Binding PairedAt, StringFormat='{}{0:g}'}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <!-- Action Buttons -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Button Padding="12,6" Margin="3,0"
                                                        Click="UnblockDevice_Click" Tag="{Binding Id}"
                                                        Visibility="{Binding IsBlocked, Converter={StaticResource BoolToVisibility}}"
                                                        Background="#107C41" Foreground="White" FontWeight="SemiBold"
                                                        BorderThickness="0" Cursor="Hand" FontSize="11">
                                                    <TextBlock Text="Unblock"/>
                                                </Button>
                                                <Button Padding="12,6" Margin="3,0"
                                                        Click="BlockDevice_Click" Tag="{Binding Id}"
                                                        Visibility="{Binding IsBlocked, Converter={StaticResource InverseBoolToVisibility}}"
                                                        Background="#D83B01" Foreground="White" FontWeight="SemiBold"
                                                        BorderThickness="0" Cursor="Hand" FontSize="11">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource IconBlock}" Fill="White" Width="11" Height="11"
                                                              Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Block" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Padding="12,6" Margin="3,0"
                                                        Click="RemoveDevice_Click" Tag="{Binding Id}"
                                                        Background="#C42B1C" Foreground="White" FontWeight="SemiBold"
                                                        BorderThickness="0" Cursor="Hand" FontSize="11">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource IconTrash}" Fill="White" Width="11" Height="11"
                                                              Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Remove" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Border x:Name="DevicesEmptyState" Background="Transparent"
                            Padding="40" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconDevice}" Fill="{StaticResource TextSecondaryBrush}"
                                  Width="40" Height="40" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,10" Opacity="0.35"/>
                            <TextBlock Text="No Paired Devices" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Scan the QR code on the Dashboard with your phone to pair and print."
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0"
                                       HorizontalAlignment="Center" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- ── 5. Server Logs Page ── -->
            <Grid x:Name="LogsPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Server Logs" FontSize="26" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Real-time server events, discovery broadcasts &amp; connection telemetry" FontSize="12.5"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource OutlinedButton}"
                                Click="CopyLogs_Click" Padding="12,6" Margin="0,0,8,0" FontSize="11.5">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconCopy}" Fill="{StaticResource TextPrimaryBrush}"
                                      Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Copy Logs" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource OutlinedButton}"
                                Click="OpenLogsFolder_Click" Padding="12,6" Margin="0,0,8,0" FontSize="11.5">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconFolder}" Fill="{StaticResource TextPrimaryBrush}"
                                      Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Logs Folder" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource OutlinedButton}"
                                Click="ClearLogs_Click" Padding="12,6" FontSize="11.5">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconTrash}" Fill="{StaticResource TextPrimaryBrush}"
                                      Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Clear Logs" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
                <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="0">
                    <TextBox x:Name="LogsTextBox" Background="#FFFFFF"
                             Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Cascadia Code, Consolas, monospace"
                             FontSize="12" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                             TextWrapping="Wrap" BorderThickness="0" Padding="16"
                             Text="Server logs will appear here..."/>
                </Border>
            </Grid>

            <!-- ── 6. Settings Page (Windows 11 Fluent Settings Cards) ── -->
            <Grid x:Name="SettingsPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,18">
                    <TextBlock Text="Settings" FontSize="26" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Configure server preferences, network security, and cloud relay" FontSize="12.5"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="720" HorizontalAlignment="Left" Margin="0,0,16,24">

                        <!-- Section 1 Header -->
                        <TextBlock Text="General Preferences" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="2,0,0,8"/>

                        <!-- Setting Row 1: Default Printer -->
                        <Border Style="{StaticResource SettingsCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="220"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Default Printer" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Preferred printer used for spooled mobile jobs and drag &amp; drop"
                                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1" x:Name="DefaultPrinterCombo"
                                          FontSize="12.5" Padding="8,5" Height="32" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Setting Row 2: Server Name & Port -->
                        <Border Style="{StaticResource SettingsCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Server Name &amp; Local Port" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Identifier broadcasted to mobile phones on your local Wi-Fi"
                                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox x:Name="ServerNameInput" Style="{StaticResource ModernTextBox}" Width="150" Margin="0,0,8,0"/>
                                    <TextBox x:Name="PortInput" Text="5000" Style="{StaticResource ModernTextBox}" Width="65"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Setting Row 3: Windows Startup Toggle -->
                        <Border Style="{StaticResource SettingsCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Start automatically with Windows" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Launch Printora Server minimized in the background on system boot"
                                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" x:Name="AutoStartCheck" Style="{StaticResource ToggleSwitch}"/>
                            </Grid>
                        </Border>

                        <!-- Setting Row 4: Minimize to Tray Toggle -->
                        <Border Style="{StaticResource SettingsCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Minimize to system tray on close" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Closing this window keeps the print server listening quietly in your taskbar"
                                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" x:Name="MinimizeToTrayCheck" Style="{StaticResource ToggleSwitch}" IsChecked="True"/>
                            </Grid>
                        </Border>

                        <!-- Section 2 Header -->
                        <TextBlock Text="Network &amp; Discovery" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="2,16,0,8"/>

                        <!-- Setting Row 5: Auto-Approve Same Wi-Fi -->
                        <Border Style="{StaticResource SettingsCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Auto-connect devices on the same Wi-Fi" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Phones connected to your local router connect seamlessly without prompting admin"
                                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" x:Name="AutoApproveSameNetworkCheck" Style="{StaticResource ToggleSwitch}" IsChecked="True"/>
                            </Grid>
                        </Border>

                        <!-- Setting Row 6: Require QR Scan Outside Local Network -->
                        <Border Style="{StaticResource SettingsCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Require QR scan &amp; admin approval for remote devices" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Unknown devices on mobile data or guest subnets must scan the QR and be accepted"
                                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" x:Name="RequireQrCodeOutsideLocalNetworkCheck" Style="{StaticResource ToggleSwitch}" IsChecked="True"/>
                            </Grid>
                        </Border>

                        <!-- Section 3 Header -->
                        <TextBlock Text="Cloud Relay (Remote Printing)" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="2,16,0,8"/>

                        <!-- Setting Row 7: Enable Cloud Relay -->
                        <Border Style="{StaticResource SettingsCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Enable Cloud Relay" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Allows authorized users to print from outside your local network via an encrypted tunnel"
                                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" x:Name="EnableCloudRelayCheck" Style="{StaticResource ToggleSwitch}"/>
                            </Grid>
                        </Border>

                        <!-- Setting Row 8: Permanent Public Domain -->
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Permanent Public Domain (Optional)" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Custom named domain (e.g., https://print.yourdomain.com) for permanent printed paper QR signs"
                                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,8"/>
                                <TextBox x:Name="CustomPublicUrlInput" Style="{StaticResource ModernTextBox}"/>

                                <!-- Tunnel Status Indicator -->
                                <Border x:Name="TunnelStatusBorder" Background="#DFF6DD" BorderBrush="#107C41" BorderThickness="1"
                                        CornerRadius="4" Padding="10,6" Margin="0,10,0,0" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock x:Name="TunnelStatusText" Text="Tunnel: Active"
                                                   Foreground="#107C41" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="TunnelUrlText" Text=""
                                                   Foreground="#107C41" FontSize="10.5" FontFamily="Consolas"
                                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Section 4 Header: Storage & Folders -->
                        <TextBlock Text="Quick Folder Shortcuts" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="2,16,0,8"/>

                        <Border Style="{StaticResource SettingsCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Open Local Application Storage" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Quick access to the spool uploads folder and diagnostic logs"
                                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource OutlinedButton}" Click="OpenUploadsFolder_Click"
                                            Padding="10,5" Margin="0,0,8,0" FontSize="11.5">
                                        <TextBlock Text="Spool Uploads"/>
                                    </Button>
                                    <Button Style="{StaticResource OutlinedButton}" Click="OpenLogsFolder_Click"
                                            Padding="10,5" FontSize="11.5">
                                        <TextBlock Text="Logs Directory"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Hidden elements to preserve backward compatibility with code-behind -->
                        <StackPanel Visibility="Collapsed">
                            <TextBox x:Name="SessionDurationInput" Text="60"/>
                            <TextBox x:Name="MaxPrintsInput" Text="10"/>
                            <TextBox x:Name="PrintCooldownInput" Text="30"/>
                        </StackPanel>

                        <!-- Save Action Button -->
                        <Button Content="Save Preferences" Style="{StaticResource ModernButton}"
                                Click="SaveSettings_Click" HorizontalAlignment="Left" Padding="24,9" Margin="0,12,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
